{
  "name": "@grove/web",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "generate:types": "node --require ./scripts/payload-compat.cjs --import tsx scripts/generate-types.mjs",
    "test": "vitest run",
    "payload": "node --require ./scripts/payload-compat.cjs ./node_modules/payload/bin.js",
    "migrate": "node --require ./scripts/payload-compat.cjs ./node_modules/payload/bin.js migrate",
    "migrate:create": "node --require ./scripts/payload-compat.cjs ./node_modules/payload/bin.js migrate:create",
    "seed": "node --require ./scripts/payload-compat.cjs --import tsx scripts/seed.mjs"
  },
  "dependencies": {
    "@grove/payload": "workspace:*",
    "@grove/types": "workspace:*",
    "@grove/ui": "workspace:*",
    "@payloadcms/db-postgres": "^3",
    "@payloadcms/next": "^3",
    "@payloadcms/plugin-multi-tenant": "^3",
    "@payloadcms/richtext-lexical": "^3",
    "@payloadcms/storage-vercel-blob": "^3.80.0",
    "@payloadcms/ui": "^3",
    "graphql": "^16",
    "next": "15.4.11",
    "payload": "^3",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.33"
  },
  "devDependencies": {
    "@grove/config": "workspace:*",
    "@next/env": "^16.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "25.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sass": "^1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
