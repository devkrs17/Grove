# Database (required for CMS)
# Locally this is the docker Postgres. In prod use your managed Postgres
# (Neon/Vercel) POOLED connection string. The app also accepts POSTGRES_URL
# (the name the Vercel/Neon integration injects) as a fallback.
DATABASE_URL=postgresql://grove:grove_dev_password@localhost:5432/grove_dev
PAYLOAD_SECRET=your-secret-here-change-in-production
SUPER_ADMIN_EMAIL=admin@grove.dev

# Deploy helpers (see DEPLOY.md)
# Set to "true" on the first production deploy so Payload creates the schema
# on boot (no migration needed). Switch to committed migrations later.
PAYLOAD_DB_PUSH=
# Vercel Blob token — when set, media uploads go to Blob instead of local disk
# (required on Vercel; the filesystem there is ephemeral). Leave blank locally.
BLOB_READ_WRITE_TOKEN=

# Auth0 (from terraform output — see infra/auth0/README.md)
AUTH0_DOMAIN=grove-dev.us.auth0.com
AUTH0_ISSUER_URL=https://grove-dev.us.auth0.com/
AUTH0_DASHBOARD_CLIENT_ID=
AUTH0_DASHBOARD_CLIENT_SECRET=
AUTH0_WEB_CLIENT_ID=
AUTH0_WEB_CLIENT_SECRET=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
