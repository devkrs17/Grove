{
  "name": "grove",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "test:coverage": "turbo test -- --coverage",
    "generate:types": "pnpm --filter @grove/web generate:types",
    "docker:up": "docker compose -f docker-compose.full.yml up -d",
    "docker:down": "docker compose -f docker-compose.full.yml down",
    "docker:restart": "docker compose -f docker-compose.full.yml restart",
    "docker:rebuild": "docker compose -f docker-compose.full.yml up -d --build",
    "docker:logs": "docker compose -f docker-compose.full.yml logs -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.14",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "turbo": "^2",
    "vitest": "^4.1.0"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp"
    ]
  }
}
